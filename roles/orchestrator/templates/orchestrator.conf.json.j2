{
  "Debug": false,
  "EnableSyslog": false,
  "ListenAddress": {{ (node_ip ~ ':' ~ (orchestrator_http_port | string)) | to_json }},
  "BackendDB": "sqlite",
  "SQLite3DataFile": "/var/lib/orchestrator/orchestrator.sqlite3",
  "RaftEnabled": true,
  "RaftDataDir": "/var/lib/orchestrator",
  "RaftBind": "{{ node_ip }}",
  "DefaultRaftPort": {{ orchestrator_raft_port }},
  "RaftNodes": {{ cluster_nodes | to_json }},
  "DefaultInstancePort": {{ mysql_port }},
  "MySQLHostnameResolveMethod": "@@report_host",
  "MySQLTopologyUser": {{ mysql_orchestrator_user | to_json }},
  "MySQLTopologyPassword": {{ mysql_orchestrator_password | to_json }},
  "MySQLTopologyCredentialsConfigFile": "",
  "DiscoverByShowSlaveHosts": true,
  "DiscoverySeeds": {{ cluster_nodes | map('regex_replace', '$', ':' ~ (mysql_port | string)) | list | to_json }},
  "MySQLConnectTimeoutSeconds": {{ orchestrator_mysql_connect_timeout_seconds }},
  "MySQLTopologyReadTimeoutSeconds": {{ orchestrator_mysql_read_timeout_seconds }},
  "InstancePollSeconds": {{ orchestrator_instance_poll_seconds }},
  "DiscoveryPollSeconds": 5,
  "UnseenInstanceForgetHours": 240,
  "DetectClusterAliasQuery": "SELECT '{{ mysql_cluster_alias }}'",
  "RecoverMasterClusterFilters": ["^({{ cluster_nodes | map('replace', '.', '[.]') | join('|') }}):{{ mysql_port }}$"],
  "ApplyMySQLPromotionAfterMasterFailover": true,
  "UseSuperReadOnly": true,
  "FailMasterPromotionIfSQLThreadNotUpToDate": true,
  "DetachLostSlavesAfterMasterFailover": true,
  "RecoveryPeriodBlockSeconds": 30,
  "ReasonableReplicationLagSeconds": 10,
  "HTTPAuthUser": {{ orchestrator_http_user | to_json }},
  "HTTPAuthPassword": {{ orchestrator_http_password | to_json }}
}
